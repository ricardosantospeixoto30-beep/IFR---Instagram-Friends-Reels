<resources>
    <string name="app_name">Friends Reels</string>
    <string name="accessibility_service_label">Friends Reels — Instagram Reader</string>
    <string name="accessibility_service_description">Reads Instagram DM conversations to discover Reels shared by your friends. Runs only when you tap Sync.</string>

    <!-- Home screen -->
    <string name="home_title">Friends Reels</string>
    <string name="home_tagline">Todos os Reels que os teus amigos te enviaram, num único feed.</string>
    <string name="home_primary_open_feed">▶ Abrir o meu feed</string>
    <string name="home_primary_hint">Vê os Reels dos teus amigos como um feed vertical: swipe para navegar, ❤ / 😂 para reagir, 💬 para responder.</string>
    <string name="home_discovery_title">Descobrir Reels</string>
    <string name="home_discovery_hint">Abre uma conversa no Instagram e usa um dos botões abaixo (ou os da notificação persistente) para importar Reels para o feed.</string>
    <string name="home_setup_title">Configuração</string>
    <string name="home_open_settings">⚙ Definições</string>
    <!-- s40 — quick shortcut on Home when there are URLs pending enrichment. -->
    <string name="home_prepare_urls_batch">🔗 Preparar URLs em lote (%1$d)</string>

    <!-- Setup / diagnostic buttons -->
    <string name="btn_enable_accessibility">Ativar serviço de acessibilidade</string>
    <string name="btn_open_instagram">Abrir Instagram</string>
    <string name="btn_react_heart">Reagir com ❤ ao 1.º Reel</string>
    <string name="btn_react_laugh">Reagir com 😂 ao 1.º Reel</string>
    <string name="btn_reply_reel">Responder com 👀 ao 1.º Reel</string>
    <string name="btn_copy_reel_url">Copiar URL do 1.º Reel (viewer → Partilhar → Copiar)</string>
    <string name="btn_discover_reels">🔍 Descobrir Reels desta conversa</string>

    <!-- Persistent notification -->
    <string name="notif_channel_name">Ações rápidas do Reels</string>
    <string name="notif_channel_description">Notificação persistente com botões para reagir ao Reel visível no Instagram.</string>
    <string name="notif_title">Friends Reels</string>
    <string name="notif_text">🔍 descobre · 🔗 copia URL · ▶ aplica fila. Toca para abrir o feed.</string>
    <string name="notif_action_copy_url">🔗</string>
    <string name="notif_action_discover">🔍</string>
    <string name="notif_action_apply">▶</string>
    <string name="notif_action_cancel">✕ Cancelar</string>
    <string name="notif_apply_progress">A aplicar %1$d/%2$d…</string>
    <string name="notif_history_progress">A descobrir histórico… scroll %1$d/%2$d, %3$d novos Reels</string>
    <string name="notif_enrich_all_progress">A preparar URLs %1$d/%2$d…</string>

    <!-- Completion feedback (s39) — transient notifications posted when
         a long-running action finishes. Separate channel so users see them
         above the persistent LOW-priority control notification. -->
    <string name="notif_channel_status_name">Conclusão de ações</string>
    <string name="notif_channel_status_description">Notificações transitórias que aparecem quando uma ação do Friends Reels termina. Podes limpar após leres.</string>
    <string name="notif_completion_tap_hint">Toca para abrir o feed.</string>
    <string name="notif_completion_batch_enrich_title">🔗 Lote de URLs terminado</string>
    <string name="notif_completion_batch_enrich_body">%1$d preparado(s) · %2$d falhou(aram).</string>
    <string name="notif_completion_batch_enrich_body_cancelled">%1$d preparado(s) · %2$d falhou(aram) — cancelado.</string>
    <string name="notif_completion_apply_pending_title">▶ Fila aplicada</string>
    <string name="notif_completion_apply_pending_body">%1$d ação(ões) executada(s) · %2$d falhou(aram).</string>
    <string name="notif_completion_apply_pending_body_cancelled">%1$d ação(ões) executada(s) · %2$d falhou(aram) — cancelado.</string>
    <string name="notif_completion_discover_title">🔍 Descoberta concluída</string>
    <string name="notif_completion_discover_body">%1$d Reel(s) novo(s) em \'%2$s\'.</string>
    <string name="notif_completion_discover_body_empty">Sem Reels novos em \'%1$s\'.</string>
    <string name="notif_completion_history_title">📥 Histórico descoberto</string>
    <string name="notif_completion_history_body">%1$d Reel(s) novo(s) em \'%2$s\' (%3$d scrolls).</string>
    <string name="notif_completion_copy_url_title">🔗 URL do Reel guardado</string>
    <string name="notif_completion_copy_url_body">de @%1$s em \'%2$s\'.</string>
    <string name="notif_completion_copy_url_body_no_author">Reel em \'%1$s\'.</string>

    <!-- Settings screen -->
    <string name="settings_title">Definições</string>
    <string name="settings_done">Concluído</string>
    <string name="settings_ignore_sent_title">Ignorar Reels enviados por mim</string>
    <string name="settings_ignore_sent_subtitle">Quando ativado, as reações e respostas só se aplicam a Reels que amigos enviaram, nunca aos que enviaste tu.</string>

    <!-- Return to app on finish (s39) -->
    <string name="settings_return_to_app_title">Voltar à app quando terminar</string>
    <string name="settings_return_to_app_subtitle">Depois de terminar ações longas (aplicar fila, preparar URLs em lote, descobrir histórico), traz o feed automaticamente para a frente para veres o resultado.</string>

    <!-- Auto-enrich on discover (s41) -->
    <string name="settings_auto_enrich_title">Preparar URLs automaticamente após descobrir</string>
    <string name="settings_auto_enrich_subtitle">Quando ativado, sempre que uma descoberta (🔍 ou 📥) inserir Reels novos sem URL, o lote de preparação arranca automaticamente logo a seguir. Torna 📥 num único gesto que traz TUDO da conversa. Default desligado — porque encadeia dois processos longos.</string>

    <!-- Selection of conversations (spec §8) -->
    <string name="settings_selection_title">Filtrar conversas no feed</string>
    <string name="settings_selection_subtitle">Escolhe se o feed mostra Reels de todas as conversas descobertas, ou só um subconjunto.</string>
    <string name="settings_selection_mode_none">Ver tudo</string>
    <string name="settings_selection_mode_include">Apenas as selecionadas em baixo</string>
    <string name="settings_selection_mode_exclude">Todas EXCEPTO as selecionadas em baixo</string>
    <string name="settings_selection_include_hint">Marca as conversas cujos Reels queres ver no feed:</string>
    <string name="settings_selection_exclude_hint">Marca as conversas cujos Reels queres esconder do feed:</string>
    <string name="settings_selection_no_threads">Ainda não descobriste Reels em nenhuma conversa. Corre \"🔍 Descobrir\" primeiro.</string>
    <string name="settings_selection_reel_count">%1$d Reels descobertos</string>

    <string name="settings_diagnostics_title">Ferramentas de diagnóstico</string>
    <string name="settings_diagnostics_body">Botões que disparam broadcasts directos ao serviço. Úteis para debug — o fluxo normal usa o feed e a notificação persistente.</string>
    <string name="btn_dump_tree">🌳 Dump da árvore da página atual (Logcat)</string>
    <string name="dump_tree_countdown">🌳 Muda para o IG! Dump em %1$d s.</string>

    <!-- Batch URL enrichment (s38) -->
    <string name="settings_batch_enrich_title">Preparar URLs em lote</string>
    <string name="settings_batch_enrich_subtitle">Vai buscar automaticamente ao Instagram o URL de todos os Reels descobertos que ainda estão sem link (o botão \"🔗 Preparar Reel\" mas para todos de uma vez). Cada Reel demora ~5-8s: mantém-te por perto e não uses o telemóvel enquanto o lote está a correr.</string>
    <string name="settings_batch_enrich_pending">%1$d Reel(s) sem URL</string>
    <string name="settings_batch_enrich_none">Todos os Reels descobertos já têm URL. Corre \"🔍 Descobrir\" ou \"📥 Descobrir histórico\" para encontrar novos.</string>
    <string name="settings_batch_enrich_start">🔗 Preparar todos</string>
    <string name="settings_batch_enrich_running">A preparar %1$d de %2$d…</string>
    <string name="settings_batch_enrich_cancel">Cancelar</string>
    <string name="settings_batch_enrich_last_result">Última execução: %1$d preparado(s), %2$d falharam</string>
    <string name="settings_batch_enrich_last_result_cancelled">Última execução (cancelada): %1$d preparado(s), %2$d falharam</string>
    <string name="settings_batch_enrich_start_toast">Lote de enriquecimento iniciado. Mantém o telemóvel livre — o Instagram vai abrir automaticamente.</string>
    <string name="settings_batch_enrich_cancel_toast">Cancelamento pedido. O lote pára depois do Reel actual.</string>

